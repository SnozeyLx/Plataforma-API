<?php

namespace App\Http\Controllers;

use App\Enums\BalanceStatementStatus;
use App\Models\BalanceStatement;
use App\Models\User;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;

class WebhookController extends Controller
{
    public function openpix(Request $request)
    {
        $auth = $request->header("Authorization");

        if ($auth !== "ronda102030") abort(404);

        $data = $request->input();

        if (isset($data["evento"]) && $data["evento"] == "teste_webhook") return ["success" => true];

        if ($data["event"] == "OPENPIX:CHARGE_COMPLETED") {
            try {

                DB::transaction(function () use ($data) {
                    $deposit = BalanceStatement::where("uuid", $data["charge"]["correlationID"])->where("status", BalanceStatementStatus::Pending)->lockForUpdate()->first();
                    if ($deposit) {
                        $user = User::where("id", $deposit->user_id)->first();
                        $user->increment("balance", $deposit->value);
                        $deposit->status = BalanceStatementStatus::Completed;
                        $deposit->save();
                    }
                }, 5);
            } catch (\Exception $e) {
                Log::error("Webhook Open Pix Error");
                Log::error($e);
                return abort(500);
            }
        }

        return ["success" => true];
    }


    public function novusPixIn(Request $request)
    {
        // ✅ Jeito simples (equivalente ao seu OpenPix): token fixo no header
        $auth = $request->header('Authorization');
        if ($auth !== config('services.novus.token', env('NOVUS_TOKEN'))) {
            abort(404);
        }

        $data = $request->all();

        // Exemplo de payload tem "status". :contentReference[oaicite:5]{index=5}
        if (!isset($data['status'])) {
            return ['success' => true];
        }

        // Processa só quando pago
        if ($data['status'] !== 'paid') {
            return ['success' => true];
        }

        // Você deve enviar external_id quando cria a invoice, e aqui ele volta no webhook. :contentReference[oaicite:6]{index=6}
        $externalId = $data['external_id'] ?? null;
        if (!$externalId) {
            Log::warning('Novus PIX-IN webhook sem external_id', ['data' => $data]);
            return ['success' => true];
        }

        try {
            DB::transaction(function () use ($externalId) {
                $deposit = BalanceStatement::where('uuid', $externalId)
                    ->where('status', BalanceStatementStatus::Pending)
                    ->lockForUpdate()
                    ->first();

                if (!$deposit) return;

                $user = User::where('id', $deposit->user_id)->first();
                if (!$user) return;

                $user->increment('balance', $deposit->value);
                $deposit->status = BalanceStatementStatus::Completed;
                $deposit->save();
            }, 5);
        } catch (\Throwable $e) {
            Log::error('Webhook Novus PIX-IN Error', ['err' => $e->getMessage()]);
            return abort(500);
        }

        return ['success' => true];
    }
}
